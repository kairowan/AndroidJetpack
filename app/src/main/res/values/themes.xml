<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Cocknovel" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:fontFamily" tools:targetApi="jelly_bean">@font/fangzhengheiti</item>
        <item name="android:typeface">serif</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <!--        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>-->
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Cocknovel.Start" parent="Theme.Cocknovel">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Cocknovel.Splash.Content" parent="Theme.Cocknovel.Start">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Cocknovel.Start.Launcher" parent="Theme.Cocknovel.Splash.Content">
        <!-- Android 11 及以下直接用启动图作为 starting window，避免先闪一层纯色背景。 -->
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@drawable/background_image</item>
    </style>

    <!--设置Tablayout字体大小-->
    <style name="TabLayoutTextSize" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hei</item>
    </style>
    <!-- 王漢宗勘亭流繁字体   -->
    <style name="appwang" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily" tools:targetApi="jelly_bean">@font/wangmozongkantingliufan</item>
    </style>
</resources>
